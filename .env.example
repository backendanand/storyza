# Application
APP_NAME=Storyza
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/storyza

# Auth
JWT_SECRET=dev-only-change-me-in-production-9f2c1a
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Queue / workers (stubbed for dev)
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=memory://

# Object storage (stubbed)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=media

# AI (Groq) - voice command understanding & chat assistant
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b